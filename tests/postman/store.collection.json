{
  "info": {
    "name": "Store API — изолированные проверки",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3101"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Проверка сервера",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 и status ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход администратора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@example.test\", \"password\": \"test-password-only\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Вход выполнен', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });",
              "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход клиента",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"customer@example.test\", \"password\": \"test-password-only\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Вход выполнен', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });",
              "if (pm.response.code === 200) pm.collectionVariables.set('customerToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Неверный пароль",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"customer@example.test\", \"password\": \"incorrect\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Отклонён неверный пароль', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Без токена",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Требуется токен', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Клиент не видит список клиентов",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Клиенту запрещён доступ', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Администратор видит клиентов",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "customers"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Список клиентов получен', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().customers).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Список заказов",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Список заказов получен', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.orders).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Некорректный статус оплаты",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "00000000-0000-0000-0000-000000000000"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"payment_status\": \"invalid\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Валидация статуса', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Отрицательный остаток",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/00000000-0000-0000-0000-000000000000/variants/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "00000000-0000-0000-0000-000000000000",
            "variants",
            "00000000-0000-0000-0000-000000000000"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"sku\": \"test\", \"size_id\": \"s\", \"color_id\": \"c\", \"stock_quantity\": -1, \"min_stock_level\": 0, \"price_adjustment\": 0, \"is_active\": true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Отрицательный остаток отклонён', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
